# Virtual environment
venv/
.venv/
env/
ENV/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python

# Runtime data: the SQLite database, mail outbox and generated CSV exports
instance/

# SQLite files, including the -shm / -wal sidecars that WAL mode creates
*.db
*.db-shm
*.db-wal
*.sqlite3

# Generated by Celery beat to remember when each job last ran
celerybeat-schedule*
celerybeat.pid

# Tests
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# Secrets - never commit real credentials
.env
.env.*

# Editors and OS
.DS_Store
Thumbs.db
.idea/
*.swp
*.md
requirements.txt
Trekking Management Application - V2.pdf
